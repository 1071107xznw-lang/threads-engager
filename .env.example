# Threads 官方 API 憑證（BAR Argo 單一帳號）
# 到 Meta App Dashboard 取得；App 需授予 threads_basic + threads_content_publish 權限。
# 注意：此為範例檔，真正的 .env 已被 .gitignore 排除，切勿把實際 token commit 進 repo。

THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_APP_SECRET=

# 乾跑模式：1/true 時不實際發文或換發 token（只記 log）；唯讀驗證仍會真的呼叫。
DRY_RUN=1

# 可選：覆寫 API base（一般不用動）
# THREADS_API_BASE=https://graph.threads.net
